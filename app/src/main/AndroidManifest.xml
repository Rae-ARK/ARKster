<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.arkster.app">

    <!-- Needed for the "Fetch info" metadata lookup (Google Books API) and for loading
         remote cover thumbnails via Coil. The app is otherwise fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- STAGE 2 MOVE -- 2026-11-11: android:name added to wire up App (Application),
         which now owns db/scanner/prefsManager/contentRepo/metadataProvider for the
         process's lifetime instead of MainActivity rebuilding them every rotation. See
         App.kt and docs/arkster/implementation/oop-modular-monolith-refactor.md. -->
    <application
        android:name=".App"
        android:allowBackup="true"
        android:label="ARKster"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="com.arkster.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
